<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sticky Note Widget</title>
    <style>
        /* Sticky note modal styling */
        #stickyModal {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 300px;
            padding: 20px;
            background-color: #fffbcc;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            border-radius: 10px;
            font-family: Arial, sans-serif;
        }
        #stickyModal textarea {
            width: 100%;
            height: 100px;
            margin-top: 10px;
            border: none;
            background: none;
            resize: none;
            outline: none;
        }
        #stickyModal button {
            display: block;
            margin: 10px auto 0;
            padding: 5px 15px;
            border: none;
            background-color: #f39c12;
            color: white;
            border-radius: 5px;
            cursor: pointer;
        }
        #openModalBtn {
            position: fixed;
            bottom: 20px;
            right: 20px;
            padding: 10px 20px;
            background-color: #f39c12;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <button id="openModalBtn" onclick="openModal()">Leave a Sticky Note</button>
    <div id="stickyModal">
        <h3>Sticky Note</h3>
        <textarea id="noteContent" placeholder="Write your comment here..."></textarea>
        <button onclick="saveNote()">Save</button>
        <button onclick="closeModal()" style="position: absolute; top: 5px; right: 10px;">&times;</button>
    </div>

    <script>
        function openModal() {
            document.getElementById("stickyModal").style.display = "block";
        }

        function closeModal() {
            document.getElementById("stickyModal").style.display = "none";
        }

        function saveNote() {
            const note = document.getElementById("noteContent").value;
            if (note) {
                localStorage.setItem('userNote', note);
                alert("Note saved!");
                closeModal();
            } else {
                alert("Please enter a note before saving.");
            }
        }

        window.onload = function() {
            const savedNote = localStorage.getItem('userNote');
            if (savedNote) {
                document.getElementById("noteContent").value = savedNote;
            }
        };
    </script>
</body>
</html>
